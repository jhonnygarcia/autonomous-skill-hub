{
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${ADO_ORG}",
        "--authentication",
        "${ADO_AUTH:-azcli}",
        "-d",
        "core",
        "work-items",
        "search",
        "wiki",
        "repositories"
      ]
    }
  }
}
